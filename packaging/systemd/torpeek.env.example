# Copy to ~/.config/torpeek/env and chmod 600 - it carries the access token.
#
# Every port here MUST come from the range your host allocated to your
# account. There is no sensible default for any of them: a guess is either
# already taken or outside the range, and outside the range is a rule broken
# rather than an error you will see.

# The web UI, proxied by nginx from the path below.
TORPEEK_WEB_PORT=

# BitTorrent. One port, a range (51000-51004) or a list - each client takes
# one of them, and pins its DHT and uTP to it too.
#
# How many you list is how many private torrents can fetch at once: all the
# public ones share a single client and a single port, but a private torrent
# needs a client of its own with DHT off. One port is fine for looking at one
# thing at a time. Leaving this empty is a startup error, not a fallback -
# the fallback would be a port outside your range.
TORPEEK_TORRENT_PORTS=

# The internal HTTP bridge, on loopback only - but a listening port all the
# same, so take it from the range like the others.
TORPEEK_BRIDGE_PORT=

# Where the UI is mounted, matching the nginx location. Leading slash, no
# trailing one.
TORPEEK_BASE_PATH=/torpeek

# Anyone with this can use the UI and the API. Generate one, do not invent
# one:  head -c 24 /dev/urandom | base64 | tr -d '=+/'
TORPEEK_WEB_TOKEN=

# Ceiling for the whole output tree; over it, whole result sets are removed
# oldest-first after each run. A number with an optional K/M/G/T suffix.
TORPEEK_CACHE_MAX_SIZE=20G

# The directory your torrent client watches for new .torrent files. With this
# set, a finished run offers a button that drops its .torrent there, which is
# how you say "download this, I have seen enough" without leaving the page.
# Leave empty and the button is absent rather than broken.
TORPEEK_WATCH_DIR=
