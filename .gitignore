# Build output
/bin/
/dist/

# Bundled ffmpeg/ffprobe live next to the binary in a release archive, never in git
/third_party/ffmpeg/

# Run artefacts
/out/
/cache/
# The -out flag's own default, so this is what a plain run inside a checkout
# leaves behind - not only the test targets. Ignored rather than tolerated
# because an untracked directory here is exactly what a blanket `git add -A`
# would sweep into the next commit.
/torpeek-out/

.DS_Store

# Isolated agent worktrees: a second checkout of this tree, created inside it
/.claude/
